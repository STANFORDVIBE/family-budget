{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Family Budget",
  "mainBinaryName": "family-budget",
  "version": "0.6.3",
  "identifier": "com.familybudget.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Family Budget",
        "width": 1360,
        "height": 840,
        "minWidth": 1280,
        "minHeight": 720,
        "center": true,
        "visible": false,
        "dragDropEnabled": false,
        "backgroundColor": "#F4F5F7"
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1430; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3OTQwNzJBNEQ5REM5MTUKUldRVnlaMU5LZ2VVTnp1S0VGK0RSSUl4aGR5U3l2ZTQwUGZFZ0VCMmNqUXdHTmloazZoVmlYUGIK",
      "endpoints": ["https://github.com/STANFORDVIBE/family-budget/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Family Budget",
    "category": "Finance",
    "shortDescription": "Личные и семейные финансы",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian"],
        "displayLanguageSelector": false
      }
    }
  }
}
